<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="viewModel"
            type="com.example.icalculatorwithstaticlayouts.CalculatorViewModel" />
    </data>

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/et_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="40dp"
            android:focusable="false"
            android:gravity="center"
            android:text="@={viewModel.displayText}"
            android:textSize="60sp"
            android:textStyle="bold" />

        <TableLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TableRow android:layout_marginBottom="12dp">
                <Button
                    android:id="@+id/btn1"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_margin="6dp"
                    android:text="1"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btn2"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_margin="6dp"
                    android:text="2"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btn3"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_margin="6dp"
                    android:text="3"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btnAdd"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_margin="6dp"
                    android:text="+"
                    android:textSize="18sp" />
            </TableRow>

            <TableRow android:layout_marginBottom="12dp">
                <Button
                    android:id="@+id/btn4"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_margin="6dp"
                    android:text="4"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btn5"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_margin="6dp"
                    android:text="5"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btn6"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_margin="6dp"
                    android:text="6"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btnSub"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_margin="6dp"
                    android:text="-"
                    android:textSize="18sp" />
            </TableRow>

            <TableRow android:layout_marginBottom="12dp">
                <Button
                    android:id="@+id/btn7"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_margin="6dp"
                    android:text="7"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btn8"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_margin="6dp"
                    android:text="8"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btn9"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_margin="6dp"
                    android:text="9"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btnMult"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_margin="6dp"
                    android:text="*"
                    android:textSize="18sp" />
            </TableRow>

            <TableRow>
                <Button
                    android:id="@+id/btnC"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_margin="6dp"
                    android:text="C"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btn0"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_margin="6dp"
                    android:text="0"
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btnEquals"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_margin="6dp"
                    android:text="="
                    android:textSize="18sp" />
                <Button
                    android:id="@+id/btnDiv"
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:layout_margin="6dp"
                    android:text="/"
                    android:textSize="18sp" />
            </TableRow>
        </TableLayout>
    </LinearLayout>
</layout>